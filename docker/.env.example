# 本地开发环境变量样例（规范 11.5：密钥只经环境变量注入，禁止入仓）
# 用法：复制为 .env 后按需修改；.env 已在 .gitignore 中排除。
#
# 端口默认避开本机可能已安装的 PostgreSQL（5432）与 Redis（6379）。

# PostgreSQL 16 + pgvector
POSTGRES_DB=contract_risk
POSTGRES_USER=crag
POSTGRES_PASSWORD=crag-dev
POSTGRES_PORT=5434

# Redis 8（规范基线为 7.x，本项目开发环境经确认使用 8.x，见 ADR 0002 偏差 10）
REDIS_PORT=6381

# 应用侧连接参数（启动 Spring Boot 时使用）
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=contract_risk
DB_USER=crag
DB_PASSWORD=crag-dev
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
